{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build SFML App",
            "type": "shell",
            "command": "clang++",
            "args": [
                "-std=c++17",
                "${file}",   // Compile the currently open file
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}", // Output file has same name as source file
                "-I/opt/homebrew/opt/sfml@2/include",
                "-L/opt/homebrew/opt/sfml@2/lib",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run SFML App",
            "type": "shell",
            "command": "${fileDirname}/${fileBasenameNoExtension}", // Run the compiled file
            "dependsOn": "Build SFML App",
            "problemMatcher": []
        }
    ]
}